# 依赖
node_modules/

# 构建产物
dist/
build/

# 环境变量（含密钥，切勿提交）
.env
.env.local
.env.*.local

# 日志
*.log
npm-debug.log*
*.out.log
*.err.log

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 缓存
.cache/
.vite/
*.tsbuildinfo
__pycache__/
*.pyc

# 本地运行数据：任务、输出音频、训练实验
# 这些是「本机产物」，换一台机器就该重来，不应进入版本库
trainer/.data/
trainer/.tmp/

# 音色库共享目录（网关与 trainer 同读写，见 server/src/services/voiceLibrary.ts）
voicelib/

# 网易模块（netease/）：独立 venv 与本机运行产物；权重在全局 models/ 规则里
netease/.venv/
netease/.data/
netease/models-src/
netease/.tmp/
server/.data/

# GPT-SoVITS 官方整合包：自带 runtime/（Python + torch）与预训练权重，14 GB 级别。
# 只在本机就地保留，由启动脚本自动探测，绝不进入版本库。
GPT-SoVITS*/

# 模型权重：RVC / DDSP-SVC 的预训练权重与训练产物（几百 MB ~ 数 GB）。
# 与整合包同属「本机产物」，由下载脚本按需拉取，不进版本库。
models/

# 线上静态版（mimo-voice-studio）的部署产物，内含一份独立的部署仓库
.pages/

# 本地编辑器 / AI 工具配置
.codebuddy/

# IndexTTS（indextts/）：上游仓库与权重本地化，体积巨大
indextts/upstream/
indextts/.venv/
indextts/checkpoints/
indextts/.data/

# Irodori-TTS（irodori/）：独立 venv + 上游代码 + 权重，合计约 8 GB。
# 权重清单（weights.manifest.json）**要进版本库** —— 它是下载与校验的唯一事实源；
# 只有实际文件不进。
irodori/.venv/
irodori/upstream/
irodori/models/
irodori/.data/
irodori/.tmp/

# GPT-SoVITS v5（gsv5/）：第五运行时（阶段 36）。独立 venv（py3.12 + torch 2.7.1 cu128）
# + 上游 main 源码（只读 clone）+ v5 权重（HF gsv-v5-pretrained）+ 共享底模 hardlink/junction。
# 试金石脚本 smoke_v5.py 与权重清单（入清单后）进版本库；实际权重与缓存不进。
gsv5/.venv/
gsv5/upstream/
gsv5/.uvcache/
gsv5/smoke-out/

# 知识收集缓存：用户手动收集物（可能含大文件），不进库；整合成果走 knowledge-atlas
knowledge-inbox/*
!knowledge-inbox/README.md

# design-studio 工作区产物（方向回合草图与渲染证据）；契约与 sidecar（surfaces/、design.json）进库
knowledge-atlas/.impeccable/mocks/
knowledge-atlas/.impeccable/review/
