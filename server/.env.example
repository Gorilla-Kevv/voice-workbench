# ===== Node 网关 - 环境变量示例 =====
# 复制为 server/.env 后按需修改。全部可选，留空即用默认值。

# 运行环境：development | production
NODE_ENV=production

# 监听地址与端口。本地工具默认只监听环回地址；
# 若要让同局域网的其它设备访问，改成 0.0.0.0 并自行确保网络可信。
HOST=127.0.0.1
PORT=8787

# ---------------- MiMo（云端模型，可选） ----------------
# 服务端 MiMo API Key。留空时用户在页面「设置」中自带密钥（BYOK）。
# 获取地址：https://platform.xiaomimimo.com/console/api-keys
MIMO_API_KEY=

# 接口地址（一般无需修改）
MIMO_BASE_URL=https://api.xiaomimimo.com/v1

# 上游超时与重试
UPSTREAM_TIMEOUT_MS=120000
UPSTREAM_RETRIES=2

# 网关限流（每 IP 每分钟请求数）
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_SYNTH_MAX=20
RATE_LIMIT_GENERAL_MAX=120

# 业务限制
MAX_TEXT_LENGTH=3000
MAX_SAMPLE_BYTES=10485760
JSON_BODY_LIMIT=20mb

# 允许的跨域来源，* 表示全部
CORS_ORIGIN=*

# 前端构建产物目录（默认自动探测 ../app/dist）
STATIC_DIR=

# 输出上游请求调试日志
VERBOSE_LOG=false

# ---------------- GPT-SoVITS 本地服务 ----------------
# Python 服务地址。默认与 trainer/.env.example 里的 PORT 保持一致。
SOVITS_URL=http://127.0.0.1:9881

# 是否由网关代为拉起 Python 服务。
# 默认 false：`npm run dev` / `npm run preview` 已经用 concurrently 单独托管了
# Python 服务，这样改后端代码（tsx watch 重启网关）不会连带重启模型服务。
# 只有单独跑 `npm run dev:server` 时，才需要设为 true 让网关自己拉起。
SOVITS_AUTOSTART=false

# GPT-SoVITS 根目录与自带解释器。留空则自动探测项目同级目录下的 GPT-SoVITS* 整合包。
GPT_SOVITS_HOME=
SOVITS_PYTHON=

# 等待 Python 服务就绪的上限（毫秒）。首次冷启动要 import torch，留足余量。
SOVITS_READY_TIMEOUT_MS=300000

# 代理请求超时（毫秒）。0 表示不超时 —— 合成与训练都是长任务，默认不限制。
SOVITS_PROXY_TIMEOUT_MS=0
