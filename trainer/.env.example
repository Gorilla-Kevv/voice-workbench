# GPT-SoVITS 本地服务配置（全部可选，留空即使用默认值）
#
# 复制为 .env 不会自动生效 —— 本服务刻意不引入 dotenv 依赖，
# 请直接把这些变量导出到环境变量，或通过 scripts/start.ps1 / start.sh 的
# 命令行参数传入（脚本内部会转成环境变量）。

# ---------------- 网络 ----------------
# 监听地址。local 模式请保持 127.0.0.1；局域网共享再改 0.0.0.0
HOST=127.0.0.1
PORT=9881
# local（本机自用，免鉴权）| public（局域网共享，带鉴权与配额）
TTS_MODE=local

# ---------------- GPT-SoVITS 定位 ----------------
# 留空则在项目同级目录与常见位置自动搜索
GPT_SOVITS_HOME=
# 额外搜索起点（可选）
GPT_SOVITS_SEARCH_ROOT=
TTS_AUTO_DISCOVER=true

# ---------------- 推理默认值 ----------------
# 默认模型版本：v1 / v2 / v2Pro / v2ProPlus / v3 / v4
TTS_DEFAULT_VERSION=v2ProPlus
# cuda:0 / cpu / auto（auto 交给官方逻辑按显存与算力决定）
TTS_DEVICE=auto
# 留空表示跟随设备自动决定；true/false 可强制
TTS_IS_HALF=
# 参考音频默认语种
TTS_DEFAULT_PROMPT_LANG=zh
# 启动后后台预加载模型（首次合成不必等 30~90 秒）
TTS_WARMUP=true
# 单次合成文本上限（0 表示使用内置默认 20000）
MAX_TEXT_LENGTH=0

# ---------------- 资源调度 ----------------
MAX_INFER_CONCURRENCY=1
MAX_TRAIN_CONCURRENCY=1
MAX_QUEUE_SIZE=32
VRAM_RESERVE_MB=512
INFER_TIMEOUT_S=600
TRAIN_TIMEOUT_S=259200
MAX_BATCH_ITEMS=200

# ---------------- 语音转文本（ASR） ----------------
# 留空 = 自动：常驻模型优先，不可用时降级到整合包里的官方脚本
ASR_BACKEND=
# 官方脚本的尺寸语义：tiny / base / small / medium / large
# （faster-whisper 另支持 large-v2 / large-v3）
ASR_SIZE=large
# 默认语种：zh / en / ja / ko / yue；faster-whisper 另支持 auto
ASR_LANGUAGE=zh
# 精度：float32 / float16 / int8
# 注意 FunASR 的 -p 官方标注「尚未接入」，选它不会改变结果
ASR_PRECISION=float32
# 常驻通道的设备：auto / cuda:0 / cpu
ASR_DEVICE=auto
# 同一段音频 + 同一组参数只转写一次（音色库反复导入同一素材时最省时）
ASR_CACHE=true
# 说明：ASR 的模型权重不由本项目下载（常驻通道由 funasr / ModelScope /
# HuggingFace 首次使用时自动拉取），因此 scripts/download_models.py 没有 asr 选项。

# ---------------- 存储 ----------------
# 数据目录：音色库、任务、输出、实验都在这里
TTS_DATA_DIR=
# 输出音频保留天数（0 = 不清理）
OUTPUT_RETENTION_DAYS=30

# ---------------- 局域网共享（TTS_MODE=public 时生效） ----------------
ADMIN_TOKEN=
DAILY_INFER_QUOTA=500
DAILY_TRAIN_QUOTA=10
ALLOW_ORIGINS=

# ---------------- 排障 ----------------
TTS_VERBOSE=false
TTS_DRY_RUN=false
# 旁路就绪校验：用于 torch 以自定义方式安装、探针误判的场景
TTS_SKIP_READY_CHECK=false
